<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_24"
        android:paddingTop="@dimen/space_12"
        android:paddingBottom="@dimen/space_8">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_16"
            android:text="Configure the TCP listening port for the local HTTP REST server. The server will restart automatically if currently running."
            android:textAppearance="@style/TextAppearance.App.BodySecondary" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/portInputLayout"
            style="@style/Widget.App.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Server Port"
            app:errorEnabled="true"
            app:helperText="Valid range: 1024 - 65535 (Default: 8080)"
            app:helperTextTextColor="@color/text_muted"
            app:placeholderText="8080">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/portInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/input_min_height"
                android:fontFamily="monospace"
                android:inputType="number"
                android:maxLength="5"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

</ScrollView>
