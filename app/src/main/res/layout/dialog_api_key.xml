<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_16">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="Pass this key in the X-API-Key header to authenticate requests."
            android:textAppearance="@style/TextAppearance.App.BodySecondary" />

        <!-- Monospace Selectable Key Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_endpoint_box"
            android:orientation="vertical"
            android:padding="@dimen/space_10">

            <TextView
                android:id="@+id/dialogApiKeyDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/accent_auth"
                android:textIsSelectable="true"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Concise Security Notice -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_12"
            android:gravity="top"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="2dp"
                android:contentDescription="Security notice"
                android:src="@drawable/ic_info"
                app:tint="@color/accent_info" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_6"
                android:layout_weight="1"
                android:text="Regenerating invalidates the current key for connected clients."
                android:textAppearance="@style/TextAppearance.App.Helper" />

        </LinearLayout>

        <!-- Primary Action: Copy Key -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogCopyKey"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Copy Key"
            app:icon="@drawable/ic_copy"
            app:iconGravity="textStart" />

        <!-- Destructive & Secondary Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogRegenerateKey"
                style="@style/Widget.App.Button.Destructive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1"
                android:text="Generate New" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogKeyDone"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1"
                android:text="Done" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
