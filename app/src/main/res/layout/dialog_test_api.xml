<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_24"
        android:paddingTop="@dimen/space_12"
        android:paddingBottom="@dimen/space_16">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            android:text="Verify local REST API SMS dispatch and server health."
            android:textAppearance="@style/TextAppearance.App.BodySecondary" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/testPhoneInputLayout"
            style="@style/Widget.App.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:hint="Destination Phone Number"
            app:errorEnabled="true"
            app:placeholderText="+918114963709">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/testPhoneEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/input_min_height"
                android:inputType="phone"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/testMessageInputLayout"
            style="@style/Widget.App.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:hint="Test Message"
            app:errorEnabled="true"
            app:placeholderText="Test message from Free OTP Gateway">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/testMessageEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:maxLines="6"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Compact Info / Result Container -->
        <LinearLayout
            android:id="@+id/testResultContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_16"
            android:background="@drawable/bg_info_box"
            android:gravity="top"
            android:orientation="horizontal"
            android:padding="@dimen/space_12">

            <ImageView
                android:id="@+id/testResultIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:contentDescription="Status info"
                android:src="@drawable/ic_info"
                app:tint="@color/accent_info" />

            <TextView
                android:id="@+id/testResultTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:text="Tap Send Test SMS to queue a message, or Server Info to view the health endpoint."
                android:textAppearance="@style/TextAppearance.App.BodySecondary" />

        </LinearLayout>

        <!-- Primary Action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendTestSms"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send Test SMS"
            app:icon="@drawable/ic_send"
            app:iconGravity="textStart" />

        <!-- Secondary Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestServerInfo"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1"
                android:text="Server Info" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseTestDialog"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1"
                android:text="Close" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
