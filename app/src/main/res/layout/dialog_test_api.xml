<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_16">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_10"
            android:text="Test local REST API SMS dispatch or inspect server health."
            android:textAppearance="@style/TextAppearance.App.BodySecondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4"
            android:text="Destination Phone Number"
            android:textAppearance="@style/TextAppearance.App.BodySecondary" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/testPhoneInputLayout"
            style="@style/Widget.App.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_10"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/testPhoneEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/input_min_height"
                android:hint="+918114963709"
                android:inputType="phone"
                android:maxLines="1"
                android:paddingVertical="10dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_placeholder"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4"
            android:text="Test Message"
            android:textAppearance="@style/TextAppearance.App.BodySecondary" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/testMessageInputLayout"
            style="@style/Widget.App.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_10"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/testMessageEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="Test message from Free OTP Gateway"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="5"
                android:minLines="2"
                android:paddingVertical="10dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_placeholder"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Compact Inline Status / Info Row -->
        <LinearLayout
            android:id="@+id/testResultContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            android:gravity="top"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/testResultIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="2dp"
                android:contentDescription="Status info"
                android:src="@drawable/ic_info"
                app:tint="@color/accent_info" />

            <TextView
                android:id="@+id/testResultTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_6"
                android:layout_weight="1"
                android:text="Queued messages appear in Outbound SMS History."
                android:textAppearance="@style/TextAppearance.App.Helper" />

        </LinearLayout>

        <!-- Primary Action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendTestSms"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send Test SMS"
            app:icon="@drawable/ic_send"
            app:iconGravity="textStart" />

        <!-- Secondary Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestServerInfo"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1"
                android:text="Server Info" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseTestDialog"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1"
                android:text="Close" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
