<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    tools:context=".MainActivity">

    <!-- Compact Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_header"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/app_bar_height"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingVertical="@dimen/space_8">

            <TextView
                android:id="@+id/appTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.App.Title" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/headerStatusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_status_dot"
                    android:backgroundTint="@color/accent_success" />

                <TextView
                    android:id="@+id/headerSubtitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Online · Port 8080"
                    android:textAppearance="@style/TextAppearance.App.BodySecondary" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_subtle" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Main Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/fab_bottom_clearance"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingTop="@dimen/space_12">

            <!-- 1. Server Management Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/serverCard"
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <!-- Compact Server Header & Toggle Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/serverIcon"
                            android:layout_width="@dimen/icon_standard"
                            android:layout_height="@dimen/icon_standard"
                            android:contentDescription="Server status icon"
                            android:src="@drawable/ic_server"
                            app:tint="@color/accent_success" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/space_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="HTTP API Server"
                                android:textAppearance="@style/TextAppearance.App.CardHeading" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:id="@+id/statusDot"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_status_dot"
                                    android:backgroundTint="@color/accent_success" />

                                <TextView
                                    android:id="@+id/serverStatusText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="Running"
                                    android:textAppearance="@style/TextAppearance.App.StatusLabel"
                                    android:textColor="@color/accent_success" />

                            </LinearLayout>

                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/serverToggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="@dimen/touch_target_min"
                            android:minHeight="@dimen/touch_target_min"
                            android:contentDescription="Toggle API server"
                            app:thumbTint="@color/switch_thumb_tint"
                            app:trackTint="@color/switch_track_tint" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/space_12"
                        android:background="@color/divider_subtle" />

                    <!-- API Endpoint Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="API Endpoint"
                        android:textAppearance="@style/TextAppearance.App.BodySecondary" />

                    <!-- Endpoint Box -->
                    <LinearLayout
                        android:id="@+id/urlContainerLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_endpoint_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_12"
                        android:paddingEnd="@dimen/space_4"
                        android:paddingVertical="@dimen/space_4">

                        <TextView
                            android:id="@+id/baseUrlDisplay"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:paddingVertical="6dp"
                            android:textColor="@color/accent_info"
                            android:textSize="13sp"
                            android:textIsSelectable="true"
                            tools:text="http://192.168.1.38:8080" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/copyUrlButton"
                            style="@style/Widget.App.IconButton"
                            android:layout_width="@dimen/touch_target_min"
                            android:layout_height="@dimen/touch_target_min"
                            android:contentDescription="Copy API endpoint URL"
                            app:icon="@drawable/ic_copy"
                            app:iconTint="@color/accent_link" />

                    </LinearLayout>

                    <!-- Port Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Server port"
                            android:src="@drawable/ic_settings"
                            app:tint="@color/text_muted" />

                        <TextView
                            android:id="@+id/portText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:layout_weight="1"
                            android:text="Port: 8080"
                            android:textAppearance="@style/TextAppearance.App.BodySecondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/changePortButton"
                            style="@style/Widget.App.Button.Tertiary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/space_8"
                            android:text="Change Port" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 2. API Authentication & Code Preview Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <!-- Section Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_standard"
                            android:layout_height="@dimen/icon_standard"
                            android:contentDescription="API authentication icon"
                            android:src="@drawable/ic_shield_key"
                            app:tint="@color/accent_auth" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:layout_weight="1"
                            android:text="API Authentication"
                            android:textAppearance="@style/TextAppearance.App.CardHeading" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/regenerateKeyButton"
                            style="@style/Widget.App.Button.Tertiary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/space_8"
                            android:text="New Key" />

                    </LinearLayout>

                    <!-- API Key Box -->
                    <LinearLayout
                        android:id="@+id/apiKeyContainerLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:background="@drawable/bg_endpoint_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_12"
                        android:paddingEnd="@dimen/space_4"
                        android:paddingVertical="@dimen/space_4">

                        <TextView
                            android:id="@+id/apiKeyText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:paddingVertical="6dp"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            tools:text="sms_cc91••••••••43b5" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/toggleKeyVisibilityButton"
                            style="@style/Widget.App.IconButton"
                            android:layout_width="@dimen/touch_target_min"
                            android:layout_height="@dimen/touch_target_min"
                            android:contentDescription="Reveal or hide API key"
                            app:icon="@drawable/ic_visibility"
                            app:iconTint="@color/text_secondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/copyKeyButton"
                            style="@style/Widget.App.IconButton"
                            android:layout_width="@dimen/touch_target_min"
                            android:layout_height="@dimen/touch_target_min"
                            android:contentDescription="Copy API key"
                            app:icon="@drawable/ic_copy"
                            app:iconTint="@color/accent_link" />

                    </LinearLayout>

                    <!-- Request Code Preview Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Request Preview"
                            android:textAppearance="@style/TextAppearance.App.BodySecondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/copyCodeButton"
                            style="@style/Widget.App.Button.Tertiary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/space_8"
                            android:text="Copy Code"
                            app:icon="@drawable/ic_copy"
                            app:iconGravity="textStart"
                            app:iconSize="16dp" />

                    </LinearLayout>

                    <!-- Horizontally Scrollable Syntax-Highlighted Code Block -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_code_box"
                        android:fillViewport="true"
                        android:scrollbars="horizontal">

                        <TextView
                            android:id="@+id/apiUrlsText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/space_12"
                            android:textAppearance="@style/TextAppearance.App.Code"
                            tools:text="POST http://192.168.1.38:8080/api/send\nX-API-Key: &lt;YOUR_API_KEY&gt;\n{\n  &quot;phone_number&quot;: &quot;+918114963709&quot;,\n  &quot;message&quot;: &quot;Your OTP is 123456&quot;\n}" />

                    </HorizontalScrollView>

                    <!-- Secondary Actions Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/testApiButton"
                            style="@style/Widget.App.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_4"
                            android:layout_weight="1"
                            android:text="Test API"
                            app:icon="@drawable/ic_terminal"
                            app:iconGravity="textStart" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/openDashboardButton"
                            style="@style/Widget.App.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:text="Dashboard"
                            app:icon="@drawable/ic_dashboard"
                            app:iconGravity="textStart" />

                    </LinearLayout>

                    <!-- Tertiary Action: External Domain -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/externalDomainButton"
                        style="@style/Widget.App.Button.Tertiary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="Setup External Domain"
                        app:icon="@drawable/ic_web"
                        app:iconGravity="textStart" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Outbound SMS History Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:layout_marginBottom="@dimen/space_8"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Outbound SMS History"
                    android:textAppearance="@style/TextAppearance.App.SectionHeading" />

                <TextView
                    android:id="@+id/historyCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textAppearance="@style/TextAppearance.App.StatusLabel"
                    android:textColor="@color/text_secondary"
                    tools:text="2 sent" />

            </LinearLayout>

            <!-- Compact Empty State -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/emptyHistoryLayout"
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_24">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="No SMS messages"
                        android:src="@drawable/ic_empty_history"
                        app:tint="@color/text_muted" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="No SMS messages yet"
                        android:textAppearance="@style/TextAppearance.App.CardHeading" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:gravity="center"
                        android:text="OTPs and messages sent via REST API or this app will appear here."
                        android:textAppearance="@style/TextAppearance.App.BodySecondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SMS History List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/smsHistoryRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:listitem="@layout/item_sms_history" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Compact Solid Blue Primary FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/sendSmsFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_16"
        android:contentDescription="Send SMS"
        android:text="Send SMS"
        android:textAllCaps="false"
        android:textColor="@color/accent_on_primary"
        android:textSize="14sp"
        app:backgroundTint="@color/accent_primary"
        app:elevation="4dp"
        app:icon="@drawable/ic_send"
        app:iconSize="@dimen/icon_standard"
        app:iconTint="@color/accent_on_primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
