<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    tools:context=".MainActivity">

    <!-- Compact Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_header"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/app_bar_height"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingVertical="@dimen/space_6">

            <TextView
                android:id="@+id/appTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.App.Title" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/headerStatusDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_status_dot"
                    android:backgroundTint="@color/accent_success" />

                <TextView
                    android:id="@+id/headerSubtitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Online · Port 8080"
                    android:textAppearance="@style/TextAppearance.App.BodySecondary" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_subtle" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Main Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/fab_bottom_clearance"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_12"
            android:paddingTop="@dimen/space_10">

            <!-- 1. Compact HTTP API Server Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/serverCard"
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_12">

                    <!-- Server Header & Toggle Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/serverIcon"
                            android:layout_width="@dimen/icon_standard"
                            android:layout_height="@dimen/icon_standard"
                            android:contentDescription="Server status icon"
                            android:src="@drawable/ic_server"
                            app:tint="@color/accent_success" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="HTTP API Server"
                            android:textAppearance="@style/TextAppearance.App.CardHeading" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/statusDot"
                                android:layout_width="7dp"
                                android:layout_height="7dp"
                                android:background="@drawable/bg_status_dot"
                                android:backgroundTint="@color/accent_success" />

                            <TextView
                                android:id="@+id/serverStatusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="Running"
                                android:textAppearance="@style/TextAppearance.App.StatusLabel"
                                android:textColor="@color/accent_success" />

                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/serverToggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="@dimen/touch_target_min"
                            android:minHeight="@dimen/touch_target_min"
                            android:contentDescription="Toggle API server"
                            app:thumbTint="@color/switch_thumb_tint"
                            app:trackTint="@color/switch_track_tint" />

                    </LinearLayout>

                    <!-- API Endpoint Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="API Endpoint"
                        android:textAppearance="@style/TextAppearance.App.Helper" />

                    <!-- Compact Endpoint Container -->
                    <LinearLayout
                        android:id="@+id/urlContainerLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:background="@drawable/bg_endpoint_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_10"
                        android:paddingEnd="2dp">

                        <TextView
                            android:id="@+id/baseUrlDisplay"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:paddingVertical="8dp"
                            android:textColor="@color/accent_info"
                            android:textIsSelectable="true"
                            android:textSize="13sp"
                            tools:text="http://192.168.1.38:8080" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/copyUrlButton"
                            style="@style/Widget.App.IconButton"
                            android:layout_width="@dimen/touch_target_min"
                            android:layout_height="@dimen/touch_target_min"
                            android:contentDescription="Copy API endpoint URL"
                            app:icon="@drawable/ic_copy"
                            app:iconTint="@color/accent_link" />

                    </LinearLayout>

                    <!-- Compact Port Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Server port"
                            android:src="@drawable/ic_settings"
                            app:tint="@color/text_muted" />

                        <TextView
                            android:id="@+id/portText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_6"
                            android:layout_weight="1"
                            android:text="Port: 8080"
                            android:textAppearance="@style/TextAppearance.App.BodySecondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/changePortButton"
                            style="@style/Widget.App.Button.Tertiary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/space_6"
                            android:text="Change Port" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Compact API Authentication & Expandable Preview Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_12">

                    <!-- Section Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_standard"
                            android:layout_height="@dimen/icon_standard"
                            android:contentDescription="API authentication icon"
                            android:src="@drawable/ic_shield_key"
                            app:tint="@color/accent_auth" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:layout_weight="1"
                            android:text="API Authentication"
                            android:textAppearance="@style/TextAppearance.App.CardHeading" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/regenerateKeyButton"
                            style="@style/Widget.App.Button.Tertiary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/space_6"
                            android:text="New Key" />

                    </LinearLayout>

                    <!-- Masked API Key Row -->
                    <LinearLayout
                        android:id="@+id/apiKeyContainerLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/bg_endpoint_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_10"
                        android:paddingEnd="2dp">

                        <TextView
                            android:id="@+id/apiKeyText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:paddingVertical="8dp"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            tools:text="sms_cc91••••••••43b5" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/toggleKeyVisibilityButton"
                            style="@style/Widget.App.IconButton"
                            android:layout_width="@dimen/touch_target_min"
                            android:layout_height="@dimen/touch_target_min"
                            android:contentDescription="Reveal or hide API key"
                            app:icon="@drawable/ic_visibility"
                            app:iconTint="@color/text_secondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/copyKeyButton"
                            style="@style/Widget.App.IconButton"
                            android:layout_width="@dimen/touch_target_min"
                            android:layout_height="@dimen/touch_target_min"
                            android:contentDescription="Copy API key"
                            app:icon="@drawable/ic_copy"
                            app:iconTint="@color/accent_link" />

                    </LinearLayout>

                    <!-- Expandable / Collapsible API Request Preview -->
                    <LinearLayout
                        android:id="@+id/requestPreviewCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:background="@drawable/bg_code_box"
                        android:orientation="vertical">

                        <!-- Compact Summary Header (Always Visible, Tap to Expand) -->
                        <LinearLayout
                            android:id="@+id/requestPreviewHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_target_min"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/space_10"
                            android:paddingEnd="2dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="POST"
                                android:textColor="@color/syntax_method"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/previewSummaryPath"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:fontFamily="monospace"
                                android:text="/api/send · Request Preview"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <ImageView
                                android:id="@+id/requestPreviewExpandIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginEnd="@dimen/space_4"
                                android:contentDescription="Expand or collapse request preview"
                                android:src="@drawable/ic_expand_more"
                                app:tint="@color/text_secondary" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/copyCodeButton"
                                style="@style/Widget.App.IconButton"
                                android:layout_width="@dimen/touch_target_min"
                                android:layout_height="@dimen/touch_target_min"
                                android:contentDescription="Copy sample cURL request"
                                app:icon="@drawable/ic_copy"
                                app:iconTint="@color/accent_link" />

                        </LinearLayout>

                        <!-- Expanded Syntax-Highlighted Code Block -->
                        <LinearLayout
                            android:id="@+id/requestPreviewBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/divider_subtle" />

                            <HorizontalScrollView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fillViewport="true"
                                android:scrollbars="horizontal">

                                <TextView
                                    android:id="@+id/apiUrlsText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:padding="@dimen/space_10"
                                    android:textAppearance="@style/TextAppearance.App.Code" />

                            </HorizontalScrollView>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Compact Secondary Actions Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/testApiButton"
                            style="@style/Widget.App.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_4"
                            android:layout_weight="1"
                            android:text="Test API"
                            app:icon="@drawable/ic_terminal"
                            app:iconGravity="textStart" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/openDashboardButton"
                            style="@style/Widget.App.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:text="Dashboard"
                            app:icon="@drawable/ic_dashboard"
                            app:iconGravity="textStart" />

                    </LinearLayout>

                    <!-- Compact Tertiary External Domain Action -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/externalDomainButton"
                        style="@style/Widget.App.Button.Tertiary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Setup External Domain"
                        app:icon="@drawable/ic_web"
                        app:iconGravity="textStart" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Outbound SMS History Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginBottom="@dimen/space_6"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Outbound SMS History"
                    android:textAppearance="@style/TextAppearance.App.SectionHeading" />

                <TextView
                    android:id="@+id/historyCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textAppearance="@style/TextAppearance.App.StatusLabel"
                    android:textColor="@color/text_secondary"
                    tools:text="2 sent" />

            </LinearLayout>

            <!-- Compact Empty State -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/emptyHistoryLayout"
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="No SMS messages"
                        android:src="@drawable/ic_empty_history"
                        app:tint="@color/text_muted" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="No SMS messages yet"
                        android:textAppearance="@style/TextAppearance.App.CardHeading" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:text="Sent OTPs and messages will appear here."
                        android:textAppearance="@style/TextAppearance.App.Helper" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SMS History Recycler View -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/smsHistoryRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:listitem="@layout/item_sms_history" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Circular Icon-Only Send SMS Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/sendSmsFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_16"
        android:contentDescription="Send SMS"
        android:src="@drawable/ic_send"
        app:backgroundTint="@color/accent_primary"
        app:elevation="4dp"
        app:fabCustomSize="@dimen/fab_size"
        app:maxImageSize="@dimen/icon_primary"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:tint="@color/accent_on_primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
