<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Sms" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorOnPrimary">@color/accent_on_primary</item>
        <item name="colorPrimaryContainer">@color/bg_elevated</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <item name="colorSecondary">@color/accent_link</item>
        <item name="colorOnSecondary">@color/bg_app</item>
        <item name="colorSecondaryContainer">@color/bg_elevated</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>

        <item name="android:colorBackground">@color/bg_app</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_elevated</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainer">@color/bg_card</item>
        <item name="colorSurfaceContainerLow">@color/bg_card</item>
        <item name="colorSurfaceContainerHigh">@color/bg_dialog</item>
        <item name="colorSurfaceContainerHighest">@color/bg_elevated</item>

        <!-- Disable Material 3 blue tonal surface tint overlay so dialogs stay pure charcoal -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="elevationOverlayColor">@android:color/transparent</item>

        <item name="colorOutline">@color/border_default</item>
        <item name="colorOutlineVariant">@color/divider_subtle</item>
        <item name="colorError">@color/accent_error</item>
        <item name="colorOnError">@color/accent_on_primary</item>

        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/accent_link</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_placeholder</item>

        <item name="android:statusBarColor">@color/bg_header</item>
        <item name="android:navigationBarColor">@color/bg_app</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
    </style>

    <style name="Theme.Sms" parent="Base.Theme.Sms" />
</resources>
