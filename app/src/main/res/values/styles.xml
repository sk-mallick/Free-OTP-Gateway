<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Typography System (sp-based, respects Android font scaling) -->
    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.DialogTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.SectionHeading" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.CardHeading" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.BodyPrimary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="TextAppearance.App.BodySecondary" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="TextAppearance.App.Helper" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="TextAppearance.App.StatusLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.App.Monospace" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Code" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/syntax_default</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <!-- Reusable Card Style -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">@dimen/stroke_width_default</item>
        <item name="strokeColor">@color/border_default</item>
        <item name="cardBackgroundColor">@color/bg_card</item>
    </style>

    <!-- Button Hierarchy -->
    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="iconSize">@dimen/icon_standard</item>
        <item name="iconTint">@color/button_primary_text</item>
    </style>

    <style name="Widget.App.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="backgroundTint">@color/button_secondary_bg</item>
        <item name="strokeColor">@color/border_default</item>
        <item name="strokeWidth">@dimen/stroke_width_default</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="iconSize">@dimen/icon_standard</item>
        <item name="iconTint">@color/text_secondary</item>
    </style>

    <style name="Widget.App.Button.Tertiary" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/accent_link</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="iconSize">@dimen/icon_standard</item>
        <item name="iconTint">@color/accent_link</item>
    </style>

    <style name="Widget.App.Button.Destructive" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/accent_error_text</item>
        <item name="cornerRadius">@dimen/radius_button</item>
    </style>

    <style name="Widget.App.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/touch_target_min</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="iconSize">@dimen/icon_standard</item>
        <item name="iconTint">@color/accent_link</item>
    </style>

    <!-- Standardized Input Field Style -->
    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/bg_input</item>
        <item name="boxStrokeColor">@color/input_box_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeErrorColor">@color/accent_error</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="hintTextColor">@color/accent_link</item>
        <item name="android:textColorHint">@color/text_placeholder</item>
        <item name="placeholderTextColor">@color/text_placeholder</item>
        <item name="helperTextTextColor">@color/text_muted</item>
        <item name="errorTextColor">@color/accent_error_text</item>
        <item name="errorIconTint">@color/accent_error_text</item>
        <item name="startIconTint">@color/text_secondary</item>
        <item name="endIconTint">@color/text_secondary</item>
    </style>

    <!-- Standardized Material 3 Dialog Theme Overlay -->
    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/bg_dialog</item>
        <item name="colorSurfaceContainerHigh">@color/bg_dialog</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Widget.App.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Widget.App.Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.Button.DialogPositive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.Button.DialogNegative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.App.Button.DialogNeutral</item>
    </style>

    <style name="ShapeAppearance.App.Dialog" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_dialog</item>
    </style>

    <style name="Widget.App.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.App.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="Widget.App.Button.DialogPositive" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent_link</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
    </style>

    <style name="Widget.App.Button.DialogNegative" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
    </style>

    <style name="Widget.App.Button.DialogNeutral" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent_link</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
    </style>
</resources>
