<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Core Dark Theme Surface Tokens -->
    <color name="bg_app">#080808</color>
    <color name="bg_header">#121212</color>
    <color name="bg_card">#1E1E1E</color>
    <color name="bg_elevated">#262626</color>
    <color name="bg_dialog">#262626</color>
    <color name="bg_input">#141414</color>
    <color name="bg_code">#141414</color>
    <color name="bg_disabled">#303030</color>
    <color name="border_default">#383838</color>
    <color name="divider_subtle">#333333</color>

    <!-- Core Text Tokens (WCAG AA >= 4.5:1 verified on dark surfaces) -->
    <color name="text_primary">#F5F5F5</color>
    <color name="text_secondary">#B3B3B3</color>
    <color name="text_muted">#949494</color>
    <color name="text_placeholder">#A0A0A0</color>
    <color name="text_disabled">#858585</color>

    <!-- Functional Solid Accent Tokens -->
    <color name="accent_primary">#2563EB</color>
    <color name="accent_primary_pressed">#1D4ED8</color>
    <color name="accent_on_primary">#FFFFFF</color>
    <color name="accent_link">#60A5FA</color>
    <color name="accent_success">#22C55E</color>
    <color name="accent_success_bg">#142E1D</color>
    <color name="accent_error">#EF4444</color>
    <color name="accent_error_text">#F87171</color>
    <color name="accent_error_bg">#331616</color>
    <color name="accent_warning">#F59E0B</color>
    <color name="accent_warning_bg">#332610</color>
    <color name="accent_info">#38BDF8</color>
    <color name="accent_info_bg">#112836</color>
    <color name="accent_auth">#A78BFA</color>
    <color name="accent_auth_bg">#241D36</color>
    <color name="accent_sent">#60A5FA</color>
    <color name="accent_sent_bg">#16263F</color>
    <color name="border_focused">#60A5FA</color>

    <!-- Code Syntax Highlighting Tokens (on #141414) -->
    <color name="syntax_method">#22C55E</color>
    <color name="syntax_endpoint">#38BDF8</color>
    <color name="syntax_property">#60A5FA</color>
    <color name="syntax_value">#A78BFA</color>
    <color name="syntax_supporting">#B3B3B3</color>
    <color name="syntax_default">#E5E5E5</color>

    <!-- Legacy / Compatibility Aliases mapped to Design Tokens -->
    <color name="primary">@color/accent_primary</color>
    <color name="on_primary">@color/accent_on_primary</color>
    <color name="primary_container">@color/bg_elevated</color>
    <color name="on_primary_container">@color/text_primary</color>
    <color name="secondary">@color/accent_link</color>
    <color name="on_secondary">@color/bg_app</color>
    <color name="secondary_container">@color/bg_elevated</color>
    <color name="on_secondary_container">@color/text_primary</color>
    <color name="background">@color/bg_app</color>
    <color name="on_background">@color/text_primary</color>
    <color name="surface">@color/bg_card</color>
    <color name="on_surface">@color/text_primary</color>
    <color name="surface_variant">@color/bg_elevated</color>
    <color name="on_surface_variant">@color/text_secondary</color>
    <color name="outline">@color/border_default</color>
    <color name="outline_variant">@color/divider_subtle</color>

    <!-- Status Tokens -->
    <color name="status_delivered">@color/accent_success</color>
    <color name="status_delivered_bg">@color/accent_success_bg</color>
    <color name="status_sent">@color/accent_sent</color>
    <color name="status_sent_bg">@color/accent_sent_bg</color>
    <color name="status_pending">@color/accent_warning</color>
    <color name="status_pending_bg">@color/accent_warning_bg</color>
    <color name="status_failed">@color/accent_error_text</color>
    <color name="status_failed_bg">@color/accent_error_bg</color>
    <color name="status_unknown">@color/text_secondary</color>
    <color name="status_unknown_bg">@color/bg_elevated</color>

    <color name="code_background">@color/bg_code</color>
    <color name="code_text">@color/syntax_default</color>
    <color name="black">#000000</color>
    <color name="white">#FFFFFF</color>
</resources>
